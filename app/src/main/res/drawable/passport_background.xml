<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="720dp"
    android:height="1040dp"
    android:viewportWidth="320"
    android:viewportHeight="480">

    <!--
        Tint-friendly: every color is white, only the ALPHA differs.
        setTint() keeps each pixel's alpha and swaps in the tint color, so
        translucent parts become a light wash and opaque parts become solid lines.
    -->

    <!-- Top page -->
    <path
        android:pathData="M34,30 H286 Q290,30 290,34 V240 H30 V34 Q30,30 34,30 Z"
        android:fillColor="#40FFFFFF" />

    <!-- Bottom page (slightly stronger so the two halves read apart) -->
    <path
        android:pathData="M30,240 H290 V446 Q290,450 286,450 H34 Q30,450 30,446 Z"
        android:fillColor="#55FFFFFF" />

    <!-- Outer border -->
    <path
        android:pathData="M34,30 H286 Q290,30 290,34 V446 Q290,450 286,450 H34 Q30,450 30,446 V34 Q30,30 34,30 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3" />

    <!-- Fold -->
    <path
        android:pathData="M30,240 H290"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5" />

    <!-- Top page lines -->
    <path
        android:pathData="M160,110 H254 M160,139 H238 M160,169 H254"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Photo frame -->
    <path
        android:pathData="M45,282 H108 V383 H45 Z"
        android:fillColor="#33FFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5" />

    <!-- Data page lines -->
    <path
        android:pathData="M123,287 H261 M123,312 H234 M123,337 H261 M123,362 H213"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- MRZ lines -->
    <path
        android:pathData="M42,412 H278 M42,431 H278"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Hand -->
    <path
        android:pathData="M-4,176 L16,180 L28,194 L28,276 L18,300 L-4,314 Z"
        android:fillColor="#66FFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />

    <!-- Thumb -->
    <group
        android:translateX="54"
        android:translateY="229"
        android:rotation="-51">

        <path
            android:pathData="M-85,-13 H0 A13,13 0 0 1 0,13 H-85 Z"
            android:fillColor="#80FFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineJoin="round" />

        <!-- Thumbnail -->
        <path
            android:pathData="M-8,0 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0"
            android:fillColor="#B3FFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5" />
    </group>

</vector>